# ── Kit (ConvertKit) ────────────────────────────────────────────────────────
# Your Kit API secret key (Settings → Developer → API Keys)
KIT_API_KEY=your_kit_api_secret_key_here

# The Kit form ID to subscribe new signups to
# Find it in Kit → Forms → select your form → check the URL or embed code
KIT_FORM_ID=your_kit_form_id_here

# ── Admin panel ─────────────────────────────────────────────────────────────
# A strong random secret used to authenticate admin API requests
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=your_strong_random_admin_token_here

# ── Finance API (Railway) ────────────────────────────────────────────────────
# The public URL of your deployed Finance API on Railway
# Example: https://finance-api-production-xxxx.up.railway.app
FINANCE_API_URL=https://your-finance-api.up.railway.app
